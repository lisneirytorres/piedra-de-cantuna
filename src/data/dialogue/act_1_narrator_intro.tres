[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://src/dialogue/dialogue_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"act_1_narrator_intro"
speakers = PackedStringArray("", "", "Cantuña", "")
lines = PackedStringArray("Quito, 1550. La ciudad crece entre montañas, piedra sobre piedra.", "Cantuña, maestro constructor indígena, es conocido por sus manos firmes y su palabra cumplida.", "Fray Jodoco me mandó llamar. Debe de estar frente a la iglesia de San Francisco.", "Muévete con WASD o las flechas. Acércate a alguien y pulsa E para hablar.")
