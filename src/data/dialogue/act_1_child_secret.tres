[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://src/dialogue/dialogue_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"act_1_child_secret"
speakers = PackedStringArray("Juanito", "Juanito", "Cantuña")
lines = PackedStringArray("Una noche lo vi buscando algo junto a la pileta. Pero no vio la losa floja que hay ahí.", "Debajo hay un hueco donde escondo mis canicas. ¡Nadie lo conoce! Ni el diablo.", "Una losa floja junto a la pileta... Lo recordaré, Juanito.")
finish_flag = &"knows_hideout"
