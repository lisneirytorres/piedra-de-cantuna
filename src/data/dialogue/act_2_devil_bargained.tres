[resource]
script = ExtResource("1_script")
id = &"act_2_devil_bargained"
speakers = PackedStringArray("El Diablo", "Cantuña")
lines = PackedStringArray("¡Ja! ¿Una piedra? Mis diablillos no olvidan ni un grano de arena. Trato hecho.", "(Entonces mi salvación cabe en una sola piedra...)")
