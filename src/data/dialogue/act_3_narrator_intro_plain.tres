[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://src/dialogue/dialogue_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"act_3_narrator_intro_plain"
speakers = PackedStringArray("", "El Diablo", "Cantuña", "")
lines = PackedStringArray("La noche cae sobre Quito. Cientos de diablillos salen de las sombras a trabajar.", "Trabajen, mis pequeños. Esta alma no tiene escapatoria.", "Si falta una piedra, la obra no estará completa. Resistiré y robaré la última.", "Tus piedrecitas se lanzan solas. ESPACIO para esquivar. Recoge la luz para subir de nivel.")
