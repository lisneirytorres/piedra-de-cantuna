[gd_resource type="Resource" script_class="DialogueData" format=3]

[ext_resource type="Script" path="res://src/dialogue/dialogue_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
id = &"act_2_cantuna_dusk"
speakers = PackedStringArray("Cantuña", "Cantuña", "")
lines = PackedStringArray("Seis piedras... y aún faltan miles. Al amanecer vence el plazo.", "Me llevarán preso. Mi familia quedará en la miseria...", "El viento se enfría. Huele a azufre. Una figura aparece entre los andamios.")
