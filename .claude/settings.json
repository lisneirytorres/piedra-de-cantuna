{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(gdformat:*)",
      "Bash(gdlint:*)",
      "Bash(godot --headless:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(rm -rf:*)",
      "Edit(./referencias/**)",
      "Write(./referencias/**)"
    ]
  }
}
